if(NOT IS_ABSOLUTE "${PACKAGE_PATH}" OR PACKAGE_PATH MATCHES "[\r\n]")
    message(FATAL_ERROR "Package output must be a single absolute path: ${PACKAGE_PATH}")
endif()
if(NOT EXISTS "${PACKAGE_PATH}" OR IS_DIRECTORY "${PACKAGE_PATH}")
    message(FATAL_ERROR "Declared package output is missing: ${PACKAGE_PATH}")
endif()
file(SIZE "${PACKAGE_PATH}" _size)
if(_size EQUAL 0)
    message(FATAL_ERROR "Declared package output is empty: ${PACKAGE_PATH}")
endif()
if(NOT RECEIPT_FILE)
    message(FATAL_ERROR "RECEIPT_FILE is required")
endif()
file(WRITE "${RECEIPT_FILE}" "${PACKAGE_PATH}\n")
message(STATUS "Package output: ${PACKAGE_PATH}")
