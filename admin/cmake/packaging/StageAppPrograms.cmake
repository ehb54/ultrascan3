# Explicit target outputs only: never discover core programs in a build directory.
if(NOT APP_PROGRAM_MANIFEST OR NOT EXISTS "${APP_PROGRAM_MANIFEST}")
    message(FATAL_ERROR "APP_PROGRAM_MANIFEST must name a generated APP package manifest")
endif()
include("${APP_PROGRAM_MANIFEST}")
if(NOT US3_APP_PROGRAMS OR NOT US3_APP_EXECUTABLES)
    message(FATAL_ERROR "APP package manifest contains no executable outputs")
endif()
foreach(_executable IN LISTS US3_APP_EXECUTABLES)
    if(NOT EXISTS "${_executable}" OR IS_DIRECTORY "${_executable}")
        message(FATAL_ERROR "Required APP executable is missing: ${_executable}")
    endif()
    file(SIZE "${_executable}" _size)
    if(_size EQUAL 0)
        message(FATAL_ERROR "Required APP executable is empty: ${_executable}")
    endif()
endforeach()
foreach(_program IN LISTS US3_APP_PROGRAMS)
    message(STATUS "Staging declared APP output: ${_program}")
    file(COPY "${_program}" DESTINATION "${S_BIN}" USE_SOURCE_PERMISSIONS)
endforeach()
