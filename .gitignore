local.pri
.*
!/.gitignore
# The blanket dot-rule above also hides .github, which silently made every
# newly added workflow, composite action and issue template untracked until
# someone noticed and force-added it. Re-include the directory explicitly.
!/.github/
*.o
tmp/
moc/
moc_*.cpp
moc_predefs.h
obj/
Makefile*
qwtplot3d/
bin/
lib/
build.log
gui/qrc_images.cpp
/programs/us/us_revision.h
/us_somo/develop/include/us_revision.h
/us_somo/develop/include/us_version.h
*~
*.pro.user
*object_script*

/build/
/build-docker/
/build-docker-nodb/
/build-docker-coverage/
/cmake-build-debug/
doc/manual/build
/vcpkg/
/.idea/
/.vscode/
/_CPack_Packages/
vcpkg_installed/
configure-arm64.log
programs/us/us.rc
CMakeUserPresets.json
__pycache__
/CLAUDE.md
*.pyc
