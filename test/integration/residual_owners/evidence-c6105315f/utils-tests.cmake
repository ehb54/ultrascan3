cmake_minimum_required(VERSION 3.20)
project(ResidualOwnerUtilsVerification LANGUAGES C CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_AUTOMOC ON)
enable_testing()
set(root /tmp/us3-residual-2ddf75d6e)
find_package(Qt5 REQUIRED COMPONENTS Core Network Sql Test Xml Widgets)
foreach(component Core Network Sql Test Xml Widgets)
 if(NOT TARGET Qt::${component})
  add_library(Qt::${component} ALIAS Qt5::${component})
 endif()
endforeach()
add_subdirectory(${root}/googletest ${CMAKE_BINARY_DIR}/googletest)
add_library(verified_utils SHARED IMPORTED)
set_target_properties(verified_utils PROPERTIES IMPORTED_LOCATION ${root}/build/lib/libus_utils4.so INTERFACE_INCLUDE_DIRECTORIES "${root}/source/utils;${root}/build")
add_library(UltraScan3::Utils ALIAS verified_utils)
add_library(verified_mysql SHARED IMPORTED)
set_target_properties(verified_mysql PROPERTIES IMPORTED_LOCATION /usr/lib64/libmariadb.so INTERFACE_INCLUDE_DIRECTORIES /usr/include/mysql)
add_library(MySQL::Client ALIAS verified_mysql)
add_compile_definitions(LINUX INTEL)
set(CMAKE_SOURCE_DIR ${root}/source)
add_subdirectory(${root}/source/test/utils ${CMAKE_BINARY_DIR}/utils)
target_include_directories(test_us_utils PRIVATE ${root}/source/test/common ${root}/source/test/utils ${root}/source/test/utils/mock)
add_executable(test_d07 ${root}/source/test/utils/test_us_run_protocol.cpp)
target_include_directories(test_d07 PRIVATE ${root}/source/test/common)
target_link_libraries(test_d07 PRIVATE verified_utils Qt::Core Qt::Network Qt::Sql Qt::Xml Qt::Widgets Qt::Test gtest_main)
target_link_libraries(test_d07 PRIVATE verified_mysql)

target_compile_definitions(test_us_utils PRIVATE US3_SOURCE_DIR="${root}/source")

add_executable(test_d09 ${root}/source/test/utils/test_us_model_defaults.cpp)
target_link_libraries(test_d09 PRIVATE verified_utils Qt::Core Qt::Network Qt::Sql Qt::Xml Qt::Widgets Qt::Test gtest_main verified_mysql)

find_package(Qt5 REQUIRED COMPONENTS OpenGL PrintSupport Svg DataVisualization)
find_library(VERIFIED_QWT NAMES qwt qwt-qt5 PATHS /usr/lib64 /usr/lib64/qt5 REQUIRED)
add_executable(test_us_resplot_fem ${root}/source/test/programs/us_resplot_fem/test_us_resplot_fem.cpp)
target_include_directories(test_us_resplot_fem PRIVATE ${root}/source/test/common ${root}/source/gui ${root}/source/qwtplot3d/include /usr/include/qt5/qwt)
target_link_libraries(test_us_resplot_fem PRIVATE ${root}/build/lib/libus_gui4.so verified_utils Qt5::Widgets Qt5::Test Qt5::OpenGL Qt5::PrintSupport Qt5::Svg Qt5::DataVisualization ${VERIFIED_QWT} verified_mysql)
